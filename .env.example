# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local MongoDB. Keep the trailing slash in the URI.
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_NAME=crypto_terminal

# Create a free Demo API key in your CoinGecko account.
# Keep the real key only in your local .env file. Never commit it.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MARKET_REFRESH_SECONDS=600
CHART_CACHE_SECONDS=600
